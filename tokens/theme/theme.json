      "background": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_SCOPES"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
        "$value": "{accent.default}"
      },
      "text": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_SCOPES"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
